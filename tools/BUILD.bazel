# Prebuilt tool binaries
# Tools are downloaded via rules_multitool.
# See multitool.lock.json for versions and checksums.

# shfmt alias for devshell.sh (IDE integration via bin/shfmt)
alias(
    name = "shfmt",
    actual = "@multitool//tools/shfmt",
    visibility = ["//visibility:public"],
)

# dprint raw binary alias
alias(
    name = "dprint_bin",
    actual = "@multitool//tools/dprint",
    visibility = ["//visibility:public"],
)

# dprint wrapper (moved to tools/format for consistency with tools/lint)
alias(
    name = "dprint",
    actual = "//tools/format:dprint",
    visibility = ["//visibility:public"],
)
